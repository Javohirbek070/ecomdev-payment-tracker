# Database configuration
DATABASE_URL=sqlite:///./learning_center.db

# API Server configuration
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=development

# Telegram Bot configuration
# Obtain your token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Comma-separated list of Telegram User IDs authorized to perform financial actions (/pay, etc.)
# You can find your user ID via @userinfobot or @raw_data_bot on Telegram
TELEGRAM_ADMIN_IDS=123456789,987654321
